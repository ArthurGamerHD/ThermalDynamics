<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The simulation core. Every source file lives under Data/Scripts/Thermodynamics/Core so that
    Space Engineers compiles it as part of the mod; this project links the same files so they can
    be built and tested outside the game.

    LangVersion 6 is deliberate: it is what the in-game script compiler accepts, so anything that
    builds here will build in game.
  -->

  <PropertyGroup>
    <AssemblyName>Thermodynamics.Core</AssemblyName>
    <RootNamespace>Thermodynamics.Core</RootNamespace>
    <LangVersion>6</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!--
      Left on, from the root props: it is what makes the compiler resolve a doc comment's cref, and
      this project is the one that compiles the simulation core on its own. It was `false` here and
      the five dangling references in Core that pass 9 found were invisible to every test build
      because of it. See docs/performance.md, Pass 9, Iteration 4.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(CoreSourceRoot)**/*.cs" LinkBase="Core" />

    <!-- Outside Data/Scripts on purpose; see the file's own note. -->
    <Compile Include="TestVisibility.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VRage.Math">
      <HintPath>$(SEBinPath)/VRage.Math.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mal.Mdk2.References" Version="2.2.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>

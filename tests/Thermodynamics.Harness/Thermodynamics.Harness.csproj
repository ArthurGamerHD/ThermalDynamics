<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Thermodynamics.Harness</AssemblyName>
    <RootNamespace>Thermodynamics.Harness</RootNamespace>
    <LangVersion>latest</LangVersion>
    <SpaceEngineersBinCopyLocal>true</SpaceEngineersBinCopyLocal>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Thermodynamics.Presentation/Thermodynamics.Presentation.csproj" />
    <ProjectReference Include="../Thermodynamics.Core/Thermodynamics.Core.csproj" />
  </ItemGroup>

  <!--
    The two shape tables from the game adapter. Both are pure mappings from a subtype name onto
    port geometry and ratings, with no Sandbox.* dependency, and both are exactly the sort of
    table that goes wrong silently. Linked rather than copied so the harness measures the same
    plumbing the game builds. They were linked into Thermodynamics.Tests before the balance suite
    needed them here; the tests still see them, through this project.
  -->
  <ItemGroup>
    <Compile Include="$(GameSourceRoot)ThermalCoolantShapes.cs" LinkBase="Game" />
    <Compile Include="$(GameSourceRoot)ThermalHeatPumpShapes.cs" LinkBase="Game" />
    <Compile Include="$(GameSourceRoot)HeatSourceCommand.cs" LinkBase="Game" />
    <Compile Include="$(GameSourceRoot)HeatSourceMath.cs" LinkBase="Game" />
    <Compile Include="$(GameSourceRoot)HeatSourceBlockSetting.cs" LinkBase="Game" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mal.Mdk2.References" Version="2.2.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>

<Project>

  <!--
    The root props sends build output outside the mod folder; see the note there. MSBuild stops at
    the first Directory.Build.props it finds walking up, so this one has to ask for the parent
    explicitly or the sim projects would keep writing their bin/ and obj/ into the published tree.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Shared settings for the isolated simulation environment.

    The only Space Engineers assembly any of these projects reference is VRage.Math.dll,
    which is pure managed math (Vector3I, Vector3, Matrix, BoundingBox, Base6Directions)
    and loads fine on .NET on Linux. Everything else is plain C#.

    Resolution order for that DLL:
      1. $(SEBinPath) passed on the command line, or the SE_BIN environment variable
      2. the default Steam install path
      3. the mod's own bin/Release/net472 output, if it has been built once
  -->

  <PropertyGroup>
    <SEBinPath Condition="'$(SEBinPath)' == '' And '$(SE_BIN)' != ''">$(SE_BIN)</SEBinPath>
    <SEBinPath Condition="'$(SEBinPath)' == '' And Exists('$(HOME)/Steam/SteamLibrary/steamapps/common/SpaceEngineers/Bin64/VRage.Math.dll')">$(HOME)/Steam/SteamLibrary/steamapps/common/SpaceEngineers/Bin64</SEBinPath>
    <SEBinPath Condition="'$(SEBinPath)' == '' And Exists('$(MSBuildThisFileDirectory)../bin/Release/net472/VRage.Math.dll')">$(MSBuildThisFileDirectory)../bin/Release/net472</SEBinPath>
    <SEBinPath Condition="'$(SEBinPath)' == '' And Exists('C:/Program Files (x86)/Steam/steamapps/common/SpaceEngineers/Bin64/VRage.Math.dll')">C:/Program Files (x86)/Steam/steamapps/common/SpaceEngineers/Bin64</SEBinPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- referencing a net472 assembly from net9.0 is intentional here -->
    <NoWarn>$(NoWarn);MSB3277;NU1701;CS1591</NoWarn>
    <CoreSourceRoot>$(MSBuildThisFileDirectory)../Data/Scripts/Thermodynamics/Core/</CoreSourceRoot>
    <TelemetrySourceRoot>$(MSBuildThisFileDirectory)../Data/Scripts/Thermodynamics/Telemetry/</TelemetrySourceRoot>
    <GameSourceRoot>$(MSBuildThisFileDirectory)../Data/Scripts/Thermodynamics/Game/</GameSourceRoot>
  </PropertyGroup>

  <Target Name="VerifySEBinPath" BeforeTargets="ResolveAssemblyReferences" Condition="'$(SEBinPath)' == ''">
    <Error Text="Could not locate VRage.Math.dll. Set SE_BIN to your Space Engineers Bin64 folder, e.g. SE_BIN=/path/to/SpaceEngineers/Bin64 dotnet test" />
  </Target>

</Project>

<Project>

  <!--
    The root props sends build output outside the mod folder; see the note there. MSBuild stops at
    the first Directory.Build.props it finds walking up, so this one has to ask for the parent
    explicitly or the sim projects would keep writing their bin/ and obj/ into the published tree.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Shared settings for the isolated simulation environment.

    The only Space Engineers assembly any of these projects reference is VRage.Math.dll,
    which is pure managed math (Vector3I, Vector3, Matrix, BoundingBox, Base6Directions)
    and loads fine on .NET on Linux. Everything else is plain C#. $(SEBinPath) and the check
    that it resolved are in the root props, because the mod project needs them too.
  -->

  <PropertyGroup>
    <!--
      Server GC. The corpus passes parse tens of gigabytes of XML across thirty-one workers, which
      is about as allocation-heavy as .NET workloads get, and workstation GC stops every one of
      those workers on a single collector thread. Concurrent is off because server GC's background
      mode buys nothing for a batch job and costs a core.
    -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!--
      Optimised in every configuration. `dotnet run` and `dotnet test` build Debug, and a Debug
      assembly tells the JIT not to optimise - so every millisecond this harness ever reported
      was taken on unoptimised code, which the game never runs. Measured 2026-08-26: a step is
      3.4x slower and the fixed cost 3.9x, so the ratios a benchmark exists for were wrong as
      well as the absolutes. See performance.md, Iteration 1.
    -->
    <Optimize>true</Optimize>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- referencing a net472 assembly from net9.0 is intentional here -->
    <NoWarn>$(NoWarn);MSB3277;NU1701;CS1591</NoWarn>
    <!--
      xUnit1013 is a test method that is not a test: a public method on a test class with no [Fact]
      or [Theory]. It is the one analyser finding in this tree that is a silent failure rather than
      a style note - the suite goes green with the case not running, and nothing else says so.
      `AGrindLeavesNoPipeHoldingCoolantBecauseTheRingDrained` lost its attribute during a rewrite and
      sat unrun through several full-suite runs while the build printed this warning every time.
      See rules.md, the one observation, and backlog.md F28.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);xUnit1013</WarningsAsErrors>
    <!--
      A doc comment's cref that resolves to nothing is a comment naming something that is not
      there (R14), and it is exactly the silent kind: it compiles, it reads as documentation, and
      the reader following it finds no such member. StageLab carried two of them to a field that
      pass 8 had replaced, through eight performance passes, past EveryCitedIdentifierResolves,
      which reads rule identifiers out of the pages and does not look at cref targets at all.
      The compiler resolves them properly, including generics, overloads and inherited members,
      which no test here could do without reimplementing name binding; it just needed asking.
      Generating the documentation file is what turns the resolution on, and CS1574 with its
      relatives is what it reports. CS1591, a public member with no comment at all, stays
      suppressed: that is a coverage rule and this is a correctness one.
      See performance.md, Pass 9, Iteration 4.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      The whole family, because they are one defect: a doc comment naming something that is not
      there. CS1574 and CS1580/1581/1584/1710 are a cref that does not resolve; CS1572 is a param
      tag for a parameter the member does not have and CS1734 a paramref for one; CS1587 is a doc
      comment attached to no language element at all, which is the orphan
      NoDocCommentDescribesSomethingThatIsNotThere hunts by pattern and misses whenever the
      intervening text is not another summary; CS1570 is a comment whose XML does not parse, which
      means the tags a reader relies on are not the tags the compiler saw.
      Twenty-five of them were in the tree, four of those in the shipped mod, including a
      ProtoMember whose comment described a field that had been deleted.
      CS1573 and CS0419 are deliberately not here: a missing param tag and an ambiguous overload
      reference are coverage and precision, not a name that resolves to nothing.
      No vendored file is compiled by any project under tests/, so all nine can be errors here.
      Generic.csproj, which compiles all three vendored paths, keeps CS1570 and CS1572 as warnings
      for the five that Draygo's client carries and R6 forbids fixing; its own note says so.
    -->
    <NoWarn>$(NoWarn);CS1573;CS0419</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1572;CS1574;CS1580;CS1581;CS1584;CS1587;CS1710;CS1734</WarningsAsErrors>
    <CoreSourceRoot>$(MSBuildThisFileDirectory)../Data/Scripts/Thermodynamics/Core/</CoreSourceRoot>
    <TelemetrySourceRoot>$(MSBuildThisFileDirectory)../Data/Scripts/Thermodynamics/Telemetry/</TelemetrySourceRoot>
    <GameSourceRoot>$(MSBuildThisFileDirectory)../Data/Scripts/Thermodynamics/Game/</GameSourceRoot>
  </PropertyGroup>

</Project>

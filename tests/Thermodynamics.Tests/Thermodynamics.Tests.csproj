<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Thermodynamics.Tests</AssemblyName>
    <RootNamespace>Thermodynamics.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />

    <!--
      Roslyn, for the script-whitelist check only: it parses Data/Scripts to find the names the mod
      writes in a type position, which is the one way to tell a type from a field called Size.
      Syntax only - no compilation, no references, no semantic model.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Thermodynamics.Core/Thermodynamics.Core.csproj" />
    <ProjectReference Include="../Thermodynamics.Harness/Thermodynamics.Harness.csproj" />
  </ItemGroup>

  <!--
    The telemetry module lives outside Core because most of it reads Sandbox.* and VRage.Game
    types that cannot load here. These five files are the exception: they hold its accumulators,
    its anomaly classification, its formatting, its per-frame cost tracker and its reading of the
    world's settings, and reference
    nothing but System. They are linked rather than duplicated so the tests exercise exactly what
    the game compiles.
  -->
  <ItemGroup>
    <Compile Include="$(TelemetrySourceRoot)TelemetryStats.cs" LinkBase="Telemetry" />
    <Compile Include="$(TelemetrySourceRoot)TelemetryAnomalies.cs" LinkBase="Telemetry" />
    <Compile Include="$(TelemetrySourceRoot)TelemetryFormat.cs" LinkBase="Telemetry" />
    <Compile Include="$(TelemetrySourceRoot)WorldSettings.cs" LinkBase="Telemetry" />
    <Compile Include="$(TelemetrySourceRoot)OverlayTelemetry.cs" LinkBase="Telemetry" />
    <Compile Include="$(TelemetrySourceRoot)../OverlayBudget.cs" LinkBase="Telemetry" />
    <Compile Include="$(TelemetrySourceRoot)FrameCost.cs" LinkBase="Telemetry" />
  </ItemGroup>


  <ItemGroup>
    <Reference Include="VRage.Math">
      <HintPath>$(SEBinPath)/VRage.Math.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>


  <ItemGroup>
    <!-- Caps how many corpus walks read the corpus at once; see xunit.runner.json. -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<!--
	Definition overlay for the "simlite" profile.

	See optimized.xml for what an overlay is and why it lives outside Data/.

	Simlite grants three substeps, half what optimized does, so it needs the stiff tail brought
	down further — and it is the profile for a crowded server, so it also trims the mechanisms
	that cost the most per unit of what they add. Where heat settles is unchanged; how faithfully
	the curve on the way is drawn is not.
-->
<ThermalOverlay>
	<Note>Realistic and knowingly approximate. The stiff tail is flattened rather than floored.</Note>

	<Blocks>
		<Block Subtype="InteriorLight">
			<Set Name="Conductivity" Value="2" />
			<Set Name="SpecificHeat" Value="900" />
		</Block>
		<Block Subtype="ReflectorLight">
			<Set Name="Conductivity" Value="2" />
			<Set Name="SpecificHeat" Value="900" />
		</Block>
		<Block Subtype="EmissiveBlock">
			<Set Name="Conductivity" Value="1" />
			<Set Name="SpecificHeat" Value="840" />
		</Block>
		<Block Subtype="CameraBlock">
			<Set Name="Conductivity" Value="5" />
			<Set Name="SpecificHeat" Value="800" />
		</Block>

		<!--
			Everything the definitions never mention runs on the fallback entry. Doubling its
			specific heat halves what every unauthored block demands of the integrator, which is
			the cheapest way to buy a three-substep profile its stability - and it costs only the
			pace of those blocks' own transients, not any temperature they settle at.
		-->
		<Block>
			<Set Name="SpecificHeat" Value="900" />
		</Block>
	</Blocks>

	<Loops>
		<!--
			A ring's coolant is a shared mass with a high conductance into every pipe, which makes
			it one of the stiffest things on a grid. More coolant per pipe is more capacity for the
			same coupling, so the loop still carries the same heat and asks less of the step.
		-->
		<Set Name="CoolantMassPerPipe" Value="80" />
	</Loops>
</ThermalOverlay>

<?xml version="1.0" encoding="utf-8"?>
<!--
	Thermal properties per block type.

	SpecificHeat is in real J/(kg K) - the same number you would look up for the material, so
	steel is about 450 and aluminium about 900. A real ship at real heat capacity takes hours to
	change temperature, so the simulation divides every capacity by the HeatTimeScale setting
	(default 225) to reach a playable pace. That factor is global: it moves the clock without
	changing any equilibrium temperature or the balance between block types.

	Conductivity and Emissivity are 0..1 quality values, not physical units.
-->
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition>
			<Id>
				<TypeId>EnvironmentDefinition</TypeId>
				<SubtypeId>DefaultThermodynamics</SubtypeId>
			</Id>
			<ModExtensions>
				<Group Name="ThermalBlockProperties">
					<Bool Name="ExcludeFromSimulation" Value="false" />
					<!--W/(m K), real units: mild steel-->
					<Decimal Name="Conductivity" Value="50" />
					<!--J/(kg K), real units: mild steel, 466 J/(kg K) rounded down: most blocks are steel plate-->
					<Decimal Name="SpecificHeat" Value="450" />
					<Decimal Name="Emissivity" Value="0.125" />
					<Decimal Name="ExposedSurfaceMultiplier" Value ="1" />
					<Decimal Name="ProducerWasteEnergy" Value="0.05" />
					<Decimal Name="ConsumerWasteEnergy" Value="0.05" />
					<Decimal Name="CriticalTemperature" Value="900" />
					<Decimal Name="OverheatDamagePerKelvin" Value="1"/>
				</Group>
			</ModExtensions>
		</Definition>

		<Definition>
			<Id>
				<TypeId>CubeBlock</TypeId>
				<SubtypeId>Gauge_LG_CoolantPipe_Corner</SubtypeId>
			</Id>
			<ModExtensions>
				<Group Name="ThermalBlockProperties">
					<Bool Name="ExcludeFromSimulation" Value="false" />
					<!--
						W/(m K). Brass, not copper, and the difference is a compromise rather than a
						materials choice: copper's 400 against the conduction pace makes a 305 kg pipe
						stiff enough to outrun the substep budget, and five coolant flow tests fail on
						it. Brass is an honest plumbing alloy and is stable here. The real fix is to
						stop pricing a thin pipe as a solid billet of its own metal.
					-->
					<Decimal Name="Conductivity" Value="110" />
					<!--J/(kg K), real units: brass-->
					<Decimal Name="SpecificHeat" Value="380" />
					<Decimal Name="Emissivity" Value="0.125" />
					<Decimal Name="ExposedSurfaceMultiplier" Value ="1" />
					<Decimal Name="ProducerWasteEnergy" Value="0" />
					<Decimal Name="ConsumerWasteEnergy" Value="0" />
					<Decimal Name="CriticalTemperature" Value="1000" />
					<Decimal Name="OverheatDamagePerKelvin" Value="1"/>
				</Group>
			</ModExtensions>
		</Definition>

<?xml version="1.0" encoding="utf-8"?>
<!--
	Deliberate deviations from the derived thermal properties.

	A block's properties are no longer written here. They are derived from its build components by
	BlockThermalDerivation, which blends the real material figures in BlockMaterials by mass, so
	every block in the game and in every other mod gets properties describing what it is actually
	made of. The sim harness's "blocks" command prints the whole table.

	This file is what overrides that, and it holds two things:

	  * the blocks this mod ships, whose properties are design decisions rather than consequences
	    of a build cost - a radiator's emissivity and area scaler are the block's whole purpose;
	  * the environment-wide default, which now applies only to a block with no priced components
	    at all. Landing on it is treated as "nothing knows anything about this block", so it does
	    not override a derivation that does.

	An entry may declare as few properties as it likes: whatever it omits is derived rather than
	zeroed. The entries below are complete because they are deliberate throughout, and
	EveryEntryInCubesDeclaresEveryPropertyTheGameReads keeps them that way.

	Units are real. SpecificHeat is J/(kg K) - the number a materials table gives, so steel is
	about 466 and aluminium about 900. Conductivity is W/(m K): mild steel 50, glass 1, copper 400.
	Emissivity is a 0..1 grey-body figure. A real ship at real heat capacity takes hours to change
	temperature, so the simulation divides every capacity by the HeatTimeScale setting (default
	225) to reach a playable pace. That factor is global: it moves the clock without changing any
	equilibrium temperature or the balance between block types.
-->
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition>
			<Id>
				<TypeId>EnvironmentDefinition</TypeId>
				<SubtypeId>DefaultThermodynamics</SubtypeId>
			</Id>
			<ModExtensions>
				<Group Name="ThermalBlockProperties">
					<Bool Name="ExcludeFromSimulation" Value="false" />
					<!--W/(m K), real units: mild steel-->
					<Decimal Name="Conductivity" Value="50" />
					<!--J/(kg K), real units: mild steel, 466 J/(kg K) rounded down: most blocks are steel plate-->
					<Decimal Name="SpecificHeat" Value="450" />
					<Decimal Name="Emissivity" Value="0.125" />
					<Decimal Name="ExposedSurfaceMultiplier" Value ="1" />
					<Decimal Name="ProducerWasteEnergy" Value="0.05" />
					<Decimal Name="ConsumerWasteEnergy" Value="0.05" />
					<Decimal Name="CriticalTemperature" Value="900" />
					<Decimal Name="OverheatDamagePerKelvin" Value="1"/>
				</Group>
			</ModExtensions>
		</Definition>

		<Definition>
			<Id>
				<TypeId>CubeBlock</TypeId>
				<SubtypeId>Gauge_LG_CoolantPipe_Corner</SubtypeId>
			</Id>
			<ModExtensions>
				<Group Name="ThermalBlockProperties">
					<Bool Name="ExcludeFromSimulation" Value="false" />
					<!--
						W/(m K), real units: copper.

						This was brass for a while, because copper made a 305 kg pipe stiff enough to
						blow the loop integration up to 291,360 K. That turned out to be a defect in
						the loop's clamp rather than a limit on the material: it bounded each link
						against the parcel's whole heat capacity, so a parcel carrying two links got
						twice the energy that equalising it takes. With the ring's own limit applied
						the same case settles at 0.8 K and copper is back.
					-->
					<Decimal Name="Conductivity" Value="400" />
					<!--J/(kg K), real units: copper-->
					<Decimal Name="SpecificHeat" Value="385" />
					<Decimal Name="Emissivity" Value="0.125" />
					<Decimal Name="ExposedSurfaceMultiplier" Value ="1" />
					<Decimal Name="ProducerWasteEnergy" Value="0" />
					<Decimal Name="ConsumerWasteEnergy" Value="0" />
					<Decimal Name="CriticalTemperature" Value="1000" />
					<Decimal Name="OverheatDamagePerKelvin" Value="1"/>
				</Group>
			</ModExtensions>
		</Definition>

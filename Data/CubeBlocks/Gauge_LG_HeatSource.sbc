<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<!--
			The debug heat source. An upgrade module for the same reason the heat pump is one: it has
			to be switchable, and only a functional block has a terminal to switch it from. It
			carries no upgrades and, unlike the pumps, no resource sink either - it takes nothing
			from the grid. See blocks.md, Debug heat source.

			It shares the heat pump's model and its icon hue-shifted. The block exists to make the
			point-source path visible in a session and has no art of its own; a mesh for it would be
			a re-export of a family for a fixture, which is a cost with no player on the other end.
			See ShippedIdentityTests.TheModelTreeKeepsItsShape - a model added moves the digest, and
			this block deliberately adds none.
		-->
		<Definition xsi:type="MyObjectBuilder_UpgradeModuleDefinition">
			<Id>
				<TypeId>UpgradeModule</TypeId>
				<SubtypeId>Gauge_LG_HeatSource</SubtypeId>
			</Id>
			<DisplayName>{LOC:DisplayName_Gauge_LG_HeatSource}</DisplayName>
			<Description>{LOC:Description_Gauge_HeatSource}</Description>
			<Icon>Textures\GUI\Icons\Gauge\LG_HeatSource.dds</Icon>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="1"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Gauge\LG\Gauge_LG_HeatPump.mwm</Model>
			<Components>
				<Component Subtype="Construction" Count="10" />
				<Component Subtype="MetalGrid" Count="2" />
				<Component Subtype="Computer" Count="1" />
				<Component Subtype="SteelPlate" Count="20" />
			</Components>
			<CriticalComponent Subtype="SteelPlate" Index="0"/>
			<MountPoints>
				<MountPoint Side="Front" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
				<MountPoint Side="Back" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
				<MountPoint Side="Left" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
				<MountPoint Side="Right" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
				<MountPoint Side="Top" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
			</MountPoints>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.50" File="Models\Gauge\LG\Gauge_LG_HeatPump_BS1.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Gauge\LG\Gauge_LG_HeatPump_BS2.mwm"/>
			</BuildProgressModels>
			<BlockPairName>Gauge_HeatSource</BlockPairName>
			<BuildTimeSeconds>20</BuildTimeSeconds>
			<PCU>100</PCU>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
			<EdgeType>Light</EdgeType>
			<PrimarySound>BlockModuleProductivity</PrimarySound>
			<DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
			<DamagedSound>ParticleElectrical</DamagedSound>
			<EmissiveColorPreset>Default</EmissiveColorPreset>
			<DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<IsAirTight>false</IsAirTight>
		</Definition>
	</CubeBlocks>
</Definitions>

					<!--Metres of rock over which the day-night swing dies out.-->
					<Decimal Name="UndergroundDampingDepth" Value="20" />

					<!--Rock temperature the model warms toward below the deadzone, K.-->
					<Decimal Name="CoreTemperature" Value="3000" />

					<!--Metres below sea level before the rock starts warming toward the core.-->
					<Decimal Name="SealevelDeadzone" Value="2000" />

					<!--Fraction of the sun a full atmosphere absorbs, 0..1. From the engine's own
					SolarRadiationProtectionFactor.-->
					<Decimal Name="SolarDecay" Value="0.5" />

					<!--Convective coefficient at the surface, W/(m^2 K), in proportion to the air.-->
					<Decimal Name="ConvectionCoefficient" Value="50" />
				</Group>
			</ModExtensions>
		</Definition>


		<Definition>
			<Id>
				<TypeId>PlanetGeneratorDefinition</TypeId>
				<SubtypeId>DefaultThermodynamics</SubtypeId>
			</Id>

			<!--The fallback for any planet without an entry of its own.-->
			<ModExtensions>
				<Group Name="ThermalPlanetProperties">

					<!--Air temperature at the equator at midnight, K.-->
					<Decimal Name="NightTemperature" Value="283.15" />

					<!--Air temperature at the equator at noon, K.-->
					<Decimal Name="DayTemperature" Value="294.261" />

					<!--How much colder a pole is than the equator, K.-->
					<Decimal Name="PoleTemperatureDrop" Value="40" />

					<!--Seconds the air takes to answer the sun.-->
					<Decimal Name="AmbientLagSeconds" Value="45" />

					<!--The same lag as a share of this world's own day, which is what it should be.-->
					<Decimal Name="AmbientLagShareOfDay" Value="0.083" />

					<!--How much colder a kilometre up is, K/km.-->
					<Decimal Name="AmbientLapseRate" Value="4" />

					<!--Rock temperature below the damping depth, K — the surface's own daily mean.-->
					<Decimal Name="UndergroundTemperature" Value="280" />

					<!--Metres of rock over which the day-night swing dies out.-->
					<Decimal Name="UndergroundDampingDepth" Value="20" />

					<!--Rock temperature the model warms toward below the deadzone, K.-->
					<Decimal Name="CoreTemperature" Value="3000" />

					<!--Metres below sea level before the rock starts warming toward the core.-->
					<Decimal Name="SealevelDeadzone" Value="2000" />

					<!--Fraction of the sun a full atmosphere absorbs, 0..1.-->
					<Decimal Name="SolarDecay" Value="0.5" />

					<!--Convective coefficient at the surface, W/(m^2 K), in proportion to the air.-->
					<Decimal Name="ConvectionCoefficient" Value="50" />

					<!--The same for a grid buried in rock, W/(m^2 K).-->
					<Decimal Name="UndergroundConvectionCoefficient" Value="2" />
				</Group>
			</ModExtensions>
		</Definition>


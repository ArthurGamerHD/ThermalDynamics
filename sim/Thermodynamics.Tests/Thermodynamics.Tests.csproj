<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Thermodynamics.Tests</AssemblyName>
    <RootNamespace>Thermodynamics.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Thermodynamics.Core/Thermodynamics.Core.csproj" />
    <ProjectReference Include="../Thermodynamics.Harness/Thermodynamics.Harness.csproj" />
  </ItemGroup>

  <!--
    The telemetry module lives outside Core because most of it reads Sandbox.* and VRage.Game
    types that cannot load here. These three files are the exception: they hold its accumulators,
    its anomaly classification and its formatting, and reference nothing but System. They are
    linked rather than duplicated so the tests exercise exactly what the game compiles.
  -->
  <ItemGroup>
    <Compile Include="$(TelemetrySourceRoot)TelemetryStats.cs" LinkBase="Telemetry" />
    <Compile Include="$(TelemetrySourceRoot)TelemetryAnomalies.cs" LinkBase="Telemetry" />
    <Compile Include="$(TelemetrySourceRoot)TelemetryFormat.cs" LinkBase="Telemetry" />
  </ItemGroup>

  <!--
    Same arrangement for the game adapter: most of it reads Sandbox.* types, but the coolant
    plumbing table is a pure mapping from subtype name and block size onto a CoolantShape, and
    it is exactly the sort of table that goes wrong silently. Linked, not copied.
  -->
  <ItemGroup>
    <Compile Include="$(GameSourceRoot)ThermalCoolantShapes.cs" LinkBase="Game" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VRage.Math">
      <HintPath>$(SEBinPath)/VRage.Math.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

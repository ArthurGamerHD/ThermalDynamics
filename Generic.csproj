<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Thermodynamics</RootNamespace>
    <!--
      The game's own assemblies target .NET Framework 4.8 (VRage.Platform.Windows and its
      RestSharp dependency); targeting 4.7.2 leaves those unresolvable.
    -->
    <TargetFramework>net48</TargetFramework>
    <Platforms>x64</Platforms>
    <LangVersion>6</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateNeutralResourcesLanguageAttribute>false</GenerateNeutralResourcesLanguageAttribute>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The isolated simulation environment under tests/ has its own projects and its own build
      output. Without this the default **/*.cs glob sweeps up its obj/ folders and the mod
      project fails to compile. Space Engineers itself only ever compiles Data/Scripts.
    -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

  <!--
    Every reference resolves through $(SEBinPath), which the root props locates; see the note
    there. These were twenty-seven copies of one machine's Steam path, which made the mod project
    unbuildable anywhere else - and it is in the test solution now, so anywhere else has to work.
  -->
  <ItemGroup>
    <Reference Include="ProtoBuf.Net.Core">
      <HintPath>$(SEBinPath)/ProtoBuf.Net.Core.dll</HintPath>
    </Reference>
    <Reference Include="ProtoBuf.Net">
      <HintPath>$(SEBinPath)/ProtoBuf.Net.dll</HintPath>
    </Reference>
    <Reference Include="Sandbox.Common">
      <HintPath>$(SEBinPath)/Sandbox.Common.dll</HintPath>
    </Reference>
    <Reference Include="Sandbox.Game">
      <HintPath>$(SEBinPath)/Sandbox.Game.dll</HintPath>
    </Reference>
    <Reference Include="Sandbox.Game.XmlSerializers">
      <HintPath>$(SEBinPath)/Sandbox.Game.XmlSerializers.dll</HintPath>
    </Reference>
    <Reference Include="SpaceEngineers.Game">
      <HintPath>$(SEBinPath)/SpaceEngineers.Game.dll</HintPath>
    </Reference>
    <Reference Include="SpaceEngineers.ObjectBuilders">
      <HintPath>$(SEBinPath)/SpaceEngineers.ObjectBuilders.dll</HintPath>
    </Reference>
    <Reference Include="SpaceEngineers.ObjectBuilders.XmlSerializers">
      <HintPath>$(SEBinPath)/SpaceEngineers.ObjectBuilders.XmlSerializers.dll</HintPath>
    </Reference>
    <Reference Include="VRage">
      <HintPath>$(SEBinPath)/VRage.dll</HintPath>
    </Reference>
    <Reference Include="VRage.Ansel">
      <HintPath>$(SEBinPath)/VRage.Ansel.dll</HintPath>
    </Reference>
    <Reference Include="VRage.Audio">
      <HintPath>$(SEBinPath)/VRage.Audio.dll</HintPath>
    </Reference>
    <Reference Include="VRage.EOS">
      <HintPath>$(SEBinPath)/VRage.EOS.dll</HintPath>
    </Reference>
    <Reference Include="VRage.Game">
      <HintPath>$(SEBinPath)/VRage.Game.dll</HintPath>
    </Reference>
    <Reference Include="VRage.Input">
      <HintPath>$(SEBinPath)/VRage.Input.dll</HintPath>
    </Reference>
    <Reference Include="VRage.Library">
      <HintPath>$(SEBinPath)/VRage.Library.dll</HintPath>
    </Reference>
    <Reference Include="VRage.Math">
      <HintPath>$(SEBinPath)/VRage.Math.dll</HintPath>
    </Reference>
    <Reference Include="VRage.Mod.Io">
      <HintPath>$(SEBinPath)/VRage.Mod.Io.dll</HintPath>
    </Reference>
    <!-- VRage.Native.dll is unmanaged: referencing it produces MSB3246 "PE image has no metadata". -->
    <Reference Include="VRage.NativeAftermath">
      <HintPath>$(SEBinPath)/VRage.NativeAftermath.dll</HintPath>
    </Reference>
    <Reference Include="VRage.NativeWrapper">
      <HintPath>$(SEBinPath)/VRage.NativeWrapper.dll</HintPath>
    </Reference>
    <Reference Include="VRage.Network">
      <HintPath>$(SEBinPath)/VRage.Network.dll</HintPath>
    </Reference>
    <Reference Include="VRage.Platform.Windows">
      <HintPath>$(SEBinPath)/VRage.Platform.Windows.dll</HintPath>
    </Reference>
    <Reference Include="VRage.Render">
      <HintPath>$(SEBinPath)/VRage.Render.dll</HintPath>
    </Reference>
    <Reference Include="VRage.Render11">
      <HintPath>$(SEBinPath)/VRage.Render11.dll</HintPath>
    </Reference>
    <Reference Include="VRage.Scripting">
      <HintPath>$(SEBinPath)/VRage.Scripting.dll</HintPath>
    </Reference>
    <Reference Include="VRage.Steam">
      <HintPath>$(SEBinPath)/VRage.Steam.dll</HintPath>
    </Reference>
    <Reference Include="VRage.UserInterface">
      <HintPath>$(SEBinPath)/VRage.UserInterface.dll</HintPath>
    </Reference>
    <Reference Include="VRage.XmlSerializers">
      <HintPath>$(SEBinPath)/VRage.XmlSerializers.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>

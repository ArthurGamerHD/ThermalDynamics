<Project>

  <!--
    Build output goes outside the mod folder.

    This repository IS the mod folder - it is linked into the game so a change is testable without
    copying - which means everything sitting in it is part of what gets published to the workshop.
    Build artifacts are not part of the mod: the game compiles Data/Scripts itself at load, and the
    assemblies under bin/ exist only so the code can be compile-checked and tested here. They were
    394 MB.

    So they land in a sibling directory instead. Nothing about the mod changes, and publishing needs
    no cleanup step - which is the point, because a cleanup step that has to be remembered is a
    cleanup step that eventually is not.
  -->
  <PropertyGroup>
    <ThermalBuildRoot Condition="'$(ThermalBuildRoot)' == ''">$(MSBuildThisFileDirectory)../ThermalDynamics.build/</ThermalBuildRoot>
    <BaseOutputPath>$(ThermalBuildRoot)$(MSBuildProjectName)/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(ThermalBuildRoot)$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>

  <!--
    Where the game's assemblies are, resolved once for every project in the repository.

    This lived under tests/ and applied to the test projects alone, which is why the mod project
    carried this machine's Steam path hard-coded in twenty-seven <HintPath> elements and could only
    ever be built here. Both halves need it now: the compile-check project is in the test solution
    (rules.md C4), so a machine that can run the suite has to be a machine that can build the mod.

    Resolution order:
      1. $(SEBinPath) passed on the command line, or the SE_BIN environment variable
      2. the default Steam install path on Linux
      3. the default Steam install path on Windows

    There used to be a fourth rung - the mod's own bin/Release/net472 output - and it was
    unreachable: the property group above sends every project's output to a sibling directory, so
    nothing has written into the mod folder since. A fallback that can never fire reads as though
    somebody checked.
  -->
  <PropertyGroup>
    <SEBinPath Condition="'$(SEBinPath)' == '' And '$(SE_BIN)' != ''">$(SE_BIN)</SEBinPath>
    <SEBinPath Condition="'$(SEBinPath)' == '' And Exists('$(HOME)/Steam/SteamLibrary/steamapps/common/SpaceEngineers/Bin64/VRage.Math.dll')">$(HOME)/Steam/SteamLibrary/steamapps/common/SpaceEngineers/Bin64</SEBinPath>
    <SEBinPath Condition="'$(SEBinPath)' == '' And Exists('C:/Program Files (x86)/Steam/steamapps/common/SpaceEngineers/Bin64/VRage.Math.dll')">C:/Program Files (x86)/Steam/steamapps/common/SpaceEngineers/Bin64</SEBinPath>
  </PropertyGroup>

  <Target Name="VerifySEBinPath" BeforeTargets="ResolveAssemblyReferences" Condition="'$(SEBinPath)' == ''">
    <Error Text="Could not locate the Space Engineers Bin64 folder. Set SE_BIN, e.g. SE_BIN=/path/to/SpaceEngineers/Bin64 dotnet build" />
  </Target>

</Project>

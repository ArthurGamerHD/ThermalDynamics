<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		
		<Definition>
			<Id>
				<TypeId>EnvironmentDefinition</TypeId>
				<SubtypeId>DefaultThermodynamicsLoop</SubtypeId>
			</Id>
			<ModExtensions>
				<Group Name="ThermalLoopProperties">
					<!--kg of coolant per cubic metre of the cell a pipe occupies, so a ring's charge scales with its length AND with the grid it is built on.-->
					<Decimal Name="CoolantKilogramsPerCubicMetre" Value ="33" />
					<!--W/(m2 K): how well heat crosses between the fluid and the wall it touches, WHILE THE RING IS CIRCULATING.-->
					<Decimal Name="HeatTransferCoefficient" Value="1000" />
					<!--J/(kg K),water-glycol coolant.-->
					<Decimal Name="SpecificHeat" Value="3400" />
					<Decimal Name="PipeContactMultiplier" Value ="1" />
					<Decimal Name="SinkContactMultiplier" Value ="1" />
					<!--How fast the coolant moves with one pump at full power, metres per second — the same unit the terminal reports.-->
					<Decimal Name="LargeGridFlowRate" Value ="10" />
					<Decimal Name="SmallGridFlowRate" Value ="10" />
					<!--What survives with nothing circulating, as a share of the coefficient above.-->
					<Decimal Name="StagnantTransferFraction" Value ="0.16" />
				</Group>
			</ModExtensions>
		</Definition>

	</CubeBlocks>
</Definitions>
